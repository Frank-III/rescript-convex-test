{
  "name": "convex-rescript-codegen",
  "version": "0.1.0",
  "description": "Generate type-safe ReScript bindings from Convex backend functions",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "convex",
    "rescript",
    "codegen",
    "typescript",
    "bindings",
    "bun"
  ],
  "author": "Frank-III",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "convex-rescript": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "watch": "bun run src/cli.ts --watch",
    "test": "bun test"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.0",
    "chalk": "^5.3.0",
    "ts-morph": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Frank-III/convex-rescript-codegen"
  },
  "bugs": {
    "url": "https://github.com/Frank-III/convex-rescript-codegen/issues"
  },
  "homepage": "https://github.com/Frank-III/convex-rescript-codegen#readme"
}
